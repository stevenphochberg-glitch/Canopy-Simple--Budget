rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) &&
        incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Household sub-collections and documents
    match /households/{householdId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(householdId) &&
        incoming().createdById == request.auth.uid &&
        incoming().syncCode is string && incoming().syncCode.size() <= 10 &&
        incoming().weeklyIncomePool is number;
      allow update: if isSignedIn() && isValidId(householdId);
      allow delete: if isSignedIn() && isValidId(householdId) && existing().createdById == request.auth.uid;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidId(memberId);
      }
      match /categories/{catId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidId(catId);
      }
      match /expenses/{expId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidId(expId);
      }
      match /checkins/{checkInId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidId(checkInId);
      }
      match /checkIns/{checkInId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidId(checkInId);
      }
      match /feed/{feedId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidId(feedId);
      }
    }
  }
}